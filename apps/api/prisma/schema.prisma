generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeSide {
  LONG  @map("long")
  SHORT @map("short")
}

enum TradeStatus {
  PLANNED   @map("planned")
  OPEN      @map("open")
  CLOSED    @map("closed")
  CANCELLED @map("cancelled")
}

enum CampaignMembershipSource {
  AUTO   @map("auto")
  MANUAL @map("manual")
}

enum CampaignConflictStatus {
  UNRESOLVED @map("unresolved")
  RESOLVED   @map("resolved")
}

enum TradeAnalysisPrimaryTrend {
  UP            @map("up")
  UP_SIDEWAYS   @map("up_sideways")
  DOWN          @map("down")
  DOWN_SIDEWAYS @map("down_sideways")
}

enum TradeAnalysisBollingerBandCount {
  ONE_BAND @map("one_band")
  TWO_BAND @map("two_band")
}

enum TradeAnalysisBollingerDirection {
  NORMAL  @map("normal")
  REVERSE @map("reverse")
  CHASE   @map("chase")
}

enum TradeExecutionEvaluation {
  AS_PLANNED    @map("as_planned")
  PLAN_VIOLATED @map("plan_violated")
}

enum TradeAnalysisMaArrangement {
  BULLISH   @map("bullish")
  BEARISH   @map("bearish")
  CONGESTED @map("congested")
}

enum TradeAnalysisCross {
  NONE          @map("none")
  GOLDEN_20_60  @map("golden_20_60")
  GOLDEN_20_120 @map("golden_20_120")
  DEAD_20_60    @map("dead_20_60")
  DEAD_20_120   @map("dead_20_120")
}

enum TradeAnalysisChartPatternType {
  DOUBLE_TOP             @map("double_top")
  DOUBLE_BOTTOM          @map("double_bottom")
  HEAD_SHOULDERS         @map("head_shoulders")
  INVERSE_HEAD_SHOULDERS @map("inverse_head_shoulders")
}

enum TradeAnalysisEconomicIndicatorImpact {
  POSITIVE @map("positive")
  NEGATIVE @map("negative")
}

enum AppUserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum UserStateAuditAction {
  APPROVE
  REJECT
  DISABLE
  ENABLE
  RESET_PASSWORD
  BOOTSTRAP
}
enum Mt5PositionEntryBalanceState {
  PROVEN
  UNSUPPORTED_ANCHORED
  UNSUPPORTED_UNANCHORED
}

enum Mt5PositionEntryBalanceReason {
  UNSUPPORTED_INOUT
  UNSUPPORTED_ACCOUNT_NOT_APPROVED
  UNSUPPORTED_CHECKPOINT
  OPENING_DEAL_OUTSIDE_HISTORY
}



enum Mt5BalanceLedgerStatus {
  VERIFIED
  DIVERGED
}

model Trade {
  id                        String                  @id @default(uuid())
  symbol                    String
  side                      TradeSide
  status                    TradeStatus
  strategy                  String?
  thesis                    String?
  entryRationale            String?                 @map("entry_rationale")
  exitRationale             String?                 @map("exit_rationale")
  takeProfitCriteria        String?                 @map("take_profit_criteria")
  stopLossCriteria          String?                 @map("stop_loss_criteria")
  note                      String?
  ownerId                   String                  @map("owner_id")
  mt5AccountId              String?                 @map("mt5_account_id")
  owner                     AppUser                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  mt5Account                Mt5Account?            @relation(fields: [mt5AccountId], references: [id], onDelete: Restrict)
  campaignRoot              TradeCampaign?          @relation("CampaignRoot")
  campaignMembership        CampaignMembership?
  campaignConflicts         CampaignConflict[]
  mt5Server                 String?                 @map("mt5_server")
  mt5ServerCanonical        String?                 @map("mt5_server_canonical")
  mt5AccountLogin           BigInt?                 @map("mt5_account_login")
  mt5PositionId             BigInt?                 @map("mt5_position_id")
  accountCurrency           String?                 @map("account_currency")
  quantityLots              Decimal?                @map("quantity_lots")
  entryPrice                Decimal?                @map("entry_price")
  exitPrice                 Decimal?                @map("exit_price")
  exitReason                String?                 @map("exit_reason")
  realizedPnl               Decimal?                @map("realized_pnl")
  takeProfitPrice           Decimal?                @map("take_profit_price")
  stopLossPrice             Decimal?                @map("stop_loss_price")
  plannedTakeProfitPrice    Decimal?                @map("planned_take_profit_price")
  plannedStopLossPrice      Decimal?                @map("planned_stop_loss_price")
  openedAt                  DateTime?                @map("opened_at")
  closedAt                  DateTime?                @map("closed_at")
  seedBalance               Decimal?                @map("seed_balance")
  riskAmount                Decimal?                @map("risk_amount")
  riskPercent               Decimal?                @map("risk_percent")
  returnPercent             Decimal?                @map("return_percent")
  initialPlanId                     String?                 @map("initial_plan_id")
  initialPlanMetricContractVersion  Int?                    @map("initial_plan_metric_contract_version")
  initialPlan                       Mt5PositionEntryPlan?   @relation(fields: [initialPlanId, initialPlanMetricContractVersion], references: [id, metricContractVersion], onDelete: Restrict)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  analysis                  TradeAnalysis?
  analysisArchives          TradeAnalysisArchive[]
  entry                     TradeEntry?
  exit                      TradeExit?

  @@unique([mt5ServerCanonical, mt5AccountLogin, mt5PositionId])
  @@index([mt5Server, mt5AccountLogin])
  @@index([ownerId, mt5AccountId])
  @@map("trades")
}

model TradeCampaign {
  id           String               @id @default(uuid())
  rootTradeId  String               @unique @map("root_trade_id")
  tradingDate  DateTime             @map("trading_date") @db.Date
  ownerId      String               @map("owner_id")
  mt5AccountId String?              @map("mt5_account_id")
  memo         String?
  owner        AppUser              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  mt5Account   Mt5Account?          @relation(fields: [mt5AccountId], references: [id], onDelete: Restrict)
  images       TradeCampaignImage[]
  rootTrade    Trade                @relation("CampaignRoot", fields: [rootTradeId], references: [id], onDelete: Restrict)
  memberships  CampaignMembership[]
  conflicts    CampaignConflict[]   @relation("ConflictResolvedCampaign")
  analysis      TradeCampaignAnalysis?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([tradingDate])
  @@index([ownerId, mt5AccountId, tradingDate])
  @@map("trade_campaigns")
}

model CampaignMembership {
  id         String                   @id @default(uuid())
  campaignId String                   @map("campaign_id")
  tradeId    String                   @unique @map("trade_id")
  source     CampaignMembershipSource
  campaign   TradeCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trade      Trade                    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  @@index([campaignId])
  @@map("campaign_memberships")
}

model CampaignConflict {
  id                   String                 @id @default(uuid())
  tradeId              String                 @map("trade_id")
  candidateCampaignIds Json                   @map("candidate_campaign_ids")
  status               CampaignConflictStatus @default(UNRESOLVED)
  resolvedCampaignId   String?                @map("resolved_campaign_id")
  trade                Trade                  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  resolvedCampaign     TradeCampaign?         @relation("ConflictResolvedCampaign", fields: [resolvedCampaignId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now()) @map("created_at")
  resolvedAt           DateTime?              @map("resolved_at")

  @@unique([tradeId])
  @@index([tradeId, status])
  @@map("campaign_conflicts")
}

model TradeAnalysis {
  id                 String                           @id @default(uuid())
  tradeId            String                           @unique @map("trade_id")
  schemaVersion      Int                              @default(3) @map("schema_version")
  baseTimeframe      String?                          @map("base_timeframe")
  bollingerBandCount TradeAnalysisBollingerBandCount? @map("bollinger_band_count")
  bollingerDirection       TradeAnalysisBollingerDirection? @map("bollinger_direction")
  executionEvaluation      TradeExecutionEvaluation?         @map("execution_evaluation")
  unplannedAdditionalEntry Boolean                           @default(false) @map("unplanned_additional_entry")
  excessiveSize            Boolean                           @default(false) @map("excessive_size")
  stopLossViolation        Boolean                           @default(false) @map("stop_loss_violation")
  earlyExit                Boolean                           @default(false) @map("early_exit")
  lateExit                 Boolean                           @default(false) @map("late_exit")
  otherViolation           String?                           @map("other_violation")
  createdAt          DateTime                         @default(now()) @map("created_at")
  updatedAt          DateTime                         @updatedAt @map("updated_at")
  trade              Trade                            @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_analyses")
}

model TradeCampaignAnalysis {
  id                     String                              @id @default(uuid())
  campaignId             String                              @unique(map: "campaign_analysis_campaign_key") @map("campaign_id")
  schemaVersion          Int                                 @default(1) @map("schema_version")
  primaryTrend           TradeAnalysisPrimaryTrend?          @map("primary_trend")
  maTimeframes           Json                                @default("{}") @map("ma_timeframes")
  marketZoneEnabled      Boolean                             @default(false) @map("market_zone_enabled")
  marketZoneHigh         Decimal?                            @map("market_zone_high") @db.Decimal(65, 30)
  marketZoneLow          Decimal?                            @map("market_zone_low") @db.Decimal(65, 30)
  retailPositionEnabled  Boolean                             @default(false) @map("retail_position_enabled")
  retailBuyAveragePrice  Decimal?                            @map("retail_buy_average_price") @db.Decimal(65, 30)
  retailSellAveragePrice Decimal?                            @map("retail_sell_average_price") @db.Decimal(65, 30)
  retailBuyRatio         Decimal?                            @map("retail_buy_ratio") @db.Decimal(65, 30)
  fibonacciEnabled       Boolean                             @default(false) @map("fibonacci_enabled")
  fibonacciStartPrice    Decimal?                            @map("fibonacci_start_price") @db.Decimal(65, 30)
  fibonacciEndPrice      Decimal?                            @map("fibonacci_end_price") @db.Decimal(65, 30)
  entryReason              String?                              @map("entry_reason")
  invalidationCondition    String?                              @map("invalidation_condition")
  takeProfitCondition      String?                              @map("take_profit_condition")
  additionalEntryPlan      String?                              @map("additional_entry_plan")
  tradeScore               Int?                                 @map("trade_score")
  strengths                String?
  weaknesses               String?
  reviewUpdatedAt         DateTime                            @default(now()) @map("review_updated_at")
  createdAt              DateTime                            @default(now()) @map("created_at")
  updatedAt              DateTime                            @updatedAt @map("updated_at")
  campaign               TradeCampaign                       @relation(fields: [campaignId], references: [id], onDelete: Cascade, map: "campaign_analysis_campaign_fkey")
  economicIndicators     TradeCampaignAnalysisEconomicIndicator[]
  archives               TradeCampaignAnalysisArchive[]

  @@map("trade_campaign_analyses")
}

model TradeCampaignAnalysisArchive {
  id                 String                @id @default(uuid())
  campaignAnalysisId String                @map("campaign_analysis_id")
  source             String
  content            Json
  createdAt          DateTime              @default(now()) @map("created_at")
  analysis           TradeCampaignAnalysis @relation(fields: [campaignAnalysisId], references: [id], onDelete: Cascade, map: "campaign_analysis_archive_analysis_fkey")

  @@unique([campaignAnalysisId, source], map: "campaign_analysis_archive_source_key")
  @@map("trade_campaign_analysis_archives")
}

model TradeAnalysisArchive {
  id         String   @id @default(uuid())
  tradeId    String   @map("trade_id")
  source     String
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, source])
  @@map("trade_analysis_archives")
}
model TradeCampaignAnalysisEconomicIndicator {
  id                 String                               @id @default(uuid())
  campaignAnalysisId String                               @map("campaign_analysis_id")
  type               String
  impact             TradeAnalysisEconomicIndicatorImpact
  announcedAt        DateTime?                            @map("announced_at")
  position           Int
  analysis           TradeCampaignAnalysis                @relation(fields: [campaignAnalysisId], references: [id], onDelete: Cascade, map: "campaign_indicator_analysis_fkey")

  @@unique([campaignAnalysisId, position], map: "campaign_indicator_analysis_position_key")
  @@index([campaignAnalysisId, position], map: "campaign_indicator_analysis_position_idx")
  @@map("trade_campaign_analysis_economic_indicators")
}

model TradeCampaignImage {
  id           String        @id @default(uuid())
  campaignId   String        @map("campaign_id")
  position     Int
  uploadId     String        @map("upload_id")
  fileName     String        @map("file_name")
  mimeType     String        @map("mime_type")
  byteSize     Int           @map("byte_size")
  contentSha256 String        @map("content_sha256")
  width        Int
  height       Int
  originalName String?       @map("original_name")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  publishedAt DateTime?     @map("published_at")
  campaign     TradeCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, position])
  @@unique([campaignId, uploadId])
  @@unique([fileName])
  @@map("trade_campaign_images")
}

model TradeEntry {
  id         String   @id @default(uuid())
  tradeId    String   @unique
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  price      Decimal
  quantity   Decimal?
  occurredAt DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@map("trade_entries")
}

model TradeExit {
  id         String   @id @default(uuid())
  tradeId    String   @unique
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  price      Decimal
  quantity   Decimal?
  occurredAt DateTime
  reason     String?
  note       String?
  createdAt  DateTime @default(now())

  @@map("trade_exits")
}

model Mt5Deal {
  accountId    String     @map("account_id")
  account      Mt5Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  server       String
  accountLogin BigInt     @map("account_login")
  ticket       BigInt
  order        BigInt
  positionId   BigInt     @map("position_id")
  time         BigInt
  timeMsc      BigInt     @map("time_msc")
  timeUtc      DateTime   @map("time_utc")
  timeMscUtc   DateTime   @map("time_msc_utc")
  type         Int
  entry        Int
  magic        BigInt
  reason       Int
  volume       Decimal
  price        Decimal
  commission   Decimal
  swap         Decimal
  profit       Decimal
  fee          Decimal
  symbol       String
  comment      String
  externalId   String     @map("external_id")
  fetchedAt    DateTime   @map("fetched_at")
  rawJson      Json       @map("raw_json")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  entryBalanceAnchors Mt5PositionEntryBalance[]
  balanceEvent Mt5AccountBalanceEvent?

  @@id([server, accountLogin, ticket])
  @@index([accountId])
  @@map("mt5_deals")
}

model Mt5Order {
  accountId       String     @map("account_id")
  account         Mt5Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  server          String
  accountLogin    BigInt     @map("account_login")
  ticket          BigInt
  positionId      BigInt     @map("position_id")
  timeSetup       BigInt     @map("time_setup")
  timeSetupMsc    BigInt     @map("time_setup_msc")
  timeSetupUtc    DateTime   @map("time_setup_utc")
  timeSetupMscUtc DateTime   @map("time_setup_msc_utc")
  timeDone        BigInt     @map("time_done")
  timeDoneMsc     BigInt     @map("time_done_msc")
  timeDoneUtc     DateTime   @map("time_done_utc")
  timeDoneMscUtc  DateTime   @map("time_done_msc_utc")
  type            Int
  state           Int
  reason          Int
  volumeInitial   Decimal    @map("volume_initial")
  volumeCurrent   Decimal    @map("volume_current")
  priceOpen       Decimal    @map("price_open")
  sl              Decimal
  tp              Decimal
  priceCurrent    Decimal    @map("price_current")
  priceStopLimit  Decimal    @map("price_stoplimit")
  symbol          String
  comment         String
  externalId      String     @map("external_id")
  fetchedAt       DateTime   @map("fetched_at")
  rawJson         Json       @map("raw_json")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@id([server, accountLogin, ticket])
  @@index([server, accountLogin, positionId])
  @@index([accountId])
  @@map("mt5_orders")
}

model Mt5PositionEntryBalance {
  accountId             String                       @map("account_id")
  account               Mt5Account                   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  server                String
  accountLogin          BigInt                       @map("account_login")
  positionId            BigInt                       @map("position_id")
  entryDealTicket       BigInt?                      @map("entry_deal_ticket")
  entryOrderTicket      BigInt?                      @map("entry_order_ticket")
  entryTimeMsc          BigInt?                      @map("entry_time_msc")
  entryTimeMscUtc       DateTime?                    @map("entry_time_msc_utc")
  entryDeal             Mt5Deal?                     @relation(fields: [server, accountLogin, entryDealTicket], references: [server, accountLogin, ticket], onDelete: Restrict)
  ledgerSemanticsVersion Int                          @map("ledger_semantics_version")
  state                 Mt5PositionEntryBalanceState
  preEntryBalance       Decimal?                     @map("pre_entry_balance") @db.Decimal(65, 30)
  reason                Mt5PositionEntryBalanceReason?
  fetchedAt             DateTime                     @map("fetched_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  @@id([server, accountLogin, positionId])
  @@index([accountId])
  @@index([server, accountLogin, entryDealTicket])
  @@map("mt5_position_entry_balances")
}


model Mt5AccountBalanceEvent {
  accountId       String     @map("account_id")
  account         Mt5Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  server          String
  accountLogin    BigInt     @map("account_login")
  dealTicket      BigInt     @map("deal_ticket")
  deal            Mt5Deal    @relation(fields: [server, accountLogin, dealTicket], references: [server, accountLogin, ticket], onDelete: Restrict)
  occurredAtMsc   BigInt     @map("occurred_at_msc")
  occurredAtUtc   DateTime   @map("occurred_at_utc")
  balanceDelta    Decimal    @map("balance_delta") @db.Decimal(65, 30)
  balanceBefore   Decimal    @map("balance_before") @db.Decimal(65, 30)
  balanceAfter    Decimal    @map("balance_after") @db.Decimal(65, 30)
  currency        String
  ledgerVersion   Int        @map("ledger_version")
  fetchedAt       DateTime   @map("fetched_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@id([server, accountLogin, dealTicket])
  @@index([accountId, occurredAtMsc, dealTicket])
  @@map("mt5_account_balance_events")
}

model Mt5AccountBalanceLedgerState {
  accountId          String                 @id @map("account_id")
  account            Mt5Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  server             String
  accountLogin       BigInt                 @map("account_login")
  currency           String
  currencyDigits     Int                    @map("currency_digits")
  calculatedBalance Decimal                @map("calculated_balance") @db.Decimal(65, 30)
  currentBalance     Decimal                @map("current_balance") @db.Decimal(65, 30)
  historyFromMsc     BigInt                 @map("history_from_msc")
  historyToMsc       BigInt                 @map("history_to_msc")
  ledgerVersion      Int                    @map("ledger_version")
  status             Mt5BalanceLedgerStatus
  lastVerifiedAt     DateTime?              @map("last_verified_at")
  lastError          String?                @map("last_error")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@unique([server, accountLogin])
  @@map("mt5_account_balance_ledger_states")
}
model Mt5PositionEntryPlan {
  id                    String     @id @default(uuid())
  accountId             String     @map("account_id")
  account               Mt5Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  server                String
  accountLogin          BigInt     @map("account_login")
  positionId            BigInt     @map("position_id")
  side                  TradeSide
  entryAt               DateTime   @map("entry_at")
  entryPrice            Decimal    @map("entry_price")
  quantityLots          Decimal    @map("quantity_lots")
  takeProfitPrice       Decimal    @map("take_profit_price")
  stopLossPrice         Decimal    @map("stop_loss_price")
  preEntryBalance       Decimal    @map("pre_entry_balance")
  accountCurrency       String     @map("account_currency")
  tickSize              Decimal    @map("tick_size")
  tickValueProfit       Decimal    @map("tick_value_profit")
  tickValueLoss         Decimal    @map("tick_value_loss")
  metricContractVersion Int        @default(1) @map("metric_contract_version")
  capturedAt            DateTime   @map("captured_at")
  createdAt             DateTime   @default(now()) @map("created_at")

  trades                Trade[]

  @@unique([id, metricContractVersion])
  @@unique([server, accountLogin, positionId])
  @@index([accountId])
  @@map("mt5_position_entry_plans")
}

model TradeLegacyMetricQuarantine {
  id             String   @id @default(uuid())
  tradeId        String   @map("trade_id")
  originalRisk   Decimal? @map("original_risk_percent")
  originalReturn Decimal? @map("original_return_percent")
  reason         String
  sourceAt       DateTime? @map("source_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tradeId])
  @@map("trade_legacy_metric_quarantine")
}
model Mt5SyncStatus {
  accountId             String     @unique @map("account_id")
  account               Mt5Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  server                String
  accountLogin          BigInt     @map("account_login")
  lastSyncAt            DateTime?  @map("last_sync_at")
  lastDealTime          DateTime?  @map("last_deal_time")
  cursor                String?
  lastReceivedDealCount Int        @default(0) @map("last_received_deal_count")
  lastError             String?    @map("last_error")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@id([server, accountLogin])
  @@map("mt5_sync_status")
}

model AppUser {
  id                   String           @id @default(uuid())
  username             String
  normalizedUsername   String           @unique @map("normalized_username")
  passwordHash         String           @map("password_hash")
  status               AppUserStatus    @default(PENDING)
  isAdmin              Boolean          @default(false) @map("is_admin")
  legacyOwner          Boolean          @default(false) @map("legacy_owner")
  bootstrapCompletedAt DateTime?        @map("bootstrap_completed_at")
  approvedAt           DateTime?        @map("approved_at")
  approvedById         String?          @map("approved_by_id")
  disabledAt           DateTime?        @map("disabled_at")
  disabledById         String?          @map("disabled_by_id")
  stateVersion         Int              @default(0) @map("state_version")
  credentialVersion    Int              @default(0) @map("credential_version")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  approvedBy           AppUser?         @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: Restrict)
  approvals            AppUser[]        @relation("UserApprovals")
  disabledBy           AppUser?         @relation("UserDisables", fields: [disabledById], references: [id], onDelete: Restrict)
  disables             AppUser[]        @relation("UserDisables")
  sessions             AppSession[]
  mt5Accounts          Mt5Account[]
  trades               Trade[]
  campaigns            TradeCampaign[]
  auditAsActor         UserStateAudit[] @relation("AuditActor")
  auditAsSubject       UserStateAudit[] @relation("AuditSubject")
  statisticsPreference StatisticsPreference?

  @@index([status, createdAt])
  @@map("app_users")
}
model StatisticsPreference {
  userId                       String   @id @map("user_id")
  user                         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  breakevenPercent             Decimal  @default(0.1) @map("breakeven_percent") @db.Decimal(8, 4)
  timeZone                     String   @default("Asia/Seoul") @map("time_zone")
  tradingDayStartMinutes       Int      @default(120) @map("trading_day_start_minutes")
  asiaStartMinutes             Int      @default(540) @map("asia_start_minutes")
  asiaEndMinutes               Int      @default(960) @map("asia_end_minutes")
  londonStartMinutes           Int      @default(480) @map("london_start_minutes")
  londonEndMinutes             Int      @default(1020) @map("london_end_minutes")
  newYorkStartMinutes          Int      @default(480) @map("new_york_start_minutes")
  newYorkEndMinutes            Int      @default(1020) @map("new_york_end_minutes")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("statistics_preferences")
}

model AppSession {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  tokenDigest       Bytes     @unique @map("token_digest")
  userStateVersion  Int       @map("user_state_version")
  credentialVersion Int       @map("credential_version")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("app_sessions")
}

model LoginThrottle {
  keyDigest    Bytes     @id @map("key_digest")
  failures     Int       @default(0)
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("login_throttles")
}

model SignupThrottle {
  keyDigest    Bytes     @id @map("key_digest")
  attempts     Int       @default(0)
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("signup_throttles")
}

model UserStateAudit {
  id         String               @id @default(uuid())
  actorId    String               @map("actor_id")
  subjectId  String               @map("subject_id")
  action     UserStateAuditAction
  fromStatus AppUserStatus?       @map("from_status")
  toStatus   AppUserStatus?       @map("to_status")
  createdAt  DateTime             @default(now()) @map("created_at")
  actor      AppUser              @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  subject    AppUser              @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
  @@map("user_state_audits")
}

model Mt5Account {
  id                   String          @id @default(uuid())
  ownerId              String          @map("owner_id")
  nickname             String
  server               String          @default("")
  canonicalServer      String          @map("canonical_server")
  accountLogin         BigInt          @map("account_login")
  credentialCiphertext Bytes           @map("credential_ciphertext")
  credentialIv         Bytes           @map("credential_iv")
  credentialTag        Bytes           @map("credential_tag")
  credentialVersion    Int             @default(1) @map("credential_version")
  timeCorrectionHours  Int             @default(0) @map("time_correction_hours")
  active               Boolean         @default(true)
  replacedById         String?         @map("replaced_by_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  owner                AppUser         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  replacedBy           Mt5Account?     @relation("AccountReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces             Mt5Account[]    @relation("AccountReplacement")
  lease                Mt5SyncLease?
  trades               Trade[]
  campaigns            TradeCampaign[]
  deals                Mt5Deal[]
  orders               Mt5Order[]
  positionEntryBalances Mt5PositionEntryBalance[]
  syncStatus           Mt5SyncStatus?
  positionEntryPlans   Mt5PositionEntryPlan[]
  balanceEvents         Mt5AccountBalanceEvent[]
  balanceLedgerState    Mt5AccountBalanceLedgerState?

  @@unique([canonicalServer, accountLogin])
  @@index([ownerId, active])
  @@map("mt5_accounts")
}

model Mt5SyncLease {
  accountId String     @id @map("account_id")
  leaseId   String     @unique @map("lease_id")
  claimedAt DateTime   @map("claimed_at")
  expiresAt DateTime   @map("expires_at")
  account   Mt5Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("mt5_sync_leases")
}
