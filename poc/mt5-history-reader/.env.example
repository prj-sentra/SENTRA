# Copy to .env and keep real secrets only there.
MT5_LOGIN=
MT5_PASSWORD=
MT5_BROKER_SERVER=XMGlobal-MT5 14

# RPC server/client settings inside the container.
MT5_RPC_BIND_HOST=0.0.0.0
MT5_RPC_HOST=127.0.0.1
MT5_RPC_PORT=18812

# History export settings.
MT5_LOOKBACK_DAYS=30
MT5_INIT_TIMEOUT_MS=60000
MT5_RPC_READY_TIMEOUT_SECONDS=60
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
