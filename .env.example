# App
NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# Cloudflare Tunnel
# Create a tunnel in Cloudflare Zero Trust and paste its Docker token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Database
POSTGRES_DB=trading_journal
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev_password
DATABASE_URL=postgresql://trading:trading_dev_password@postgres:5432/trading_journal
