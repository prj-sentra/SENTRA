# App
NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Production Caddy hostname, for example journal.example.com (automatic HTTPS).
CADDY_SITE_ADDRESS=journal.example.com

# Authentication
# At least 32 random characters, used only to HMAC throttle keys.
AUTH_THROTTLE_KEY=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key, for example: openssl rand -base64 32
MT5_CREDENTIAL_ENCRYPTION_KEY=
# Optional after the first administrator has been created.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Cloudflare Tunnel
# Create a tunnel in Cloudflare Zero Trust and paste its Docker token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Database
POSTGRES_DB=trading_journal
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev_password
DATABASE_URL=postgresql://trading:trading_dev_password@postgres:5432/trading_journal

# MT5 Sync
# Public sync trigger token injected by Caddy into the API request.
MT5_SYNC_TOKEN=replace-with-random-token
# Windows MT5 bridge server
MT5_BRIDGE_BASE_URL=http://10.0.0.104:18812
MT5_BRIDGE_TOKEN=replace-with-random-token
# Bridge requests are aborted after this bounded timeout (1000-30000 ms).
MT5_BRIDGE_TIMEOUT_MS=10000
TRADE_IMAGE_DIR=/data/trade-images
