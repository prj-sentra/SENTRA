# App
NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# Cloudflare Tunnel
# Create a tunnel in Cloudflare Zero Trust and paste its Docker token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Database
POSTGRES_DB=trading_journal
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev_password
DATABASE_URL=postgresql://trading:trading_dev_password@postgres:5432/trading_journal

# LLM Wiki
WIKI_PATH=/data/wiki
# Required for POST/PUT /api/wiki/pages mutation endpoints. Keep secret.
WIKI_WRITE_TOKEN=replace-with-random-token

# MT5 Sync
# Stored on the server; used by the MT5 bridge command invoked from the API.
MT5_ACCOUNT_NUMBER=
MT5_READ_ONLY_PASSWORD=
MT5_SYNC_COMMAND=
