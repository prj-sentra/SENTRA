http://sentra.hoya.kim {
  encode gzip

  handle /api/trade-log/mt5/sync {
    uri strip_prefix /api
    reverse_proxy api:3000 {
      header_up X-MT5-Sync-Token {env.MT5_SYNC_TOKEN}
    }
  }

  handle /api/* {
    uri strip_prefix /api
    reverse_proxy api:3000
  }

  handle /health {
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:80
  }
}
